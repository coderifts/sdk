{
  "name": "@coderifts/sdk",
  "version": "3.14.3",
  "description": "Signed, offline-verifiable authorization for API-contract changes. Only a granted change can proceed. This package is the TypeScript client that preflights a change set and verifies its receipt.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:markers": "node scripts/write-dist-type-markers.mjs",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:vendor && npm run build:markers",
    "pretest": "npm run build",
    "test:types": "tsc -p tsconfig.typetest.json",
    "test": "npm run test:types && node --test --test-concurrency=1 test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "check:packed": "node scripts/check-packed-install.js",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "prepack": "node scripts/stamp-doc-version.mjs"
  },
  "keywords": [
    "coderifts",
    "api",
    "openapi",
    "breaking-changes",
    "mcp",
    "sdk",
    "agent",
    "governance",
    "ai-agent",
    "tool-safety",
    "api-contract-preflight",
    "offline-verifiable-authorization",
    "agent-authorization"
  ],
  "author": "CodeRifts <hello@coderifts.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderifts/sdk.git"
  },
  "homepage": "https://coderifts.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
