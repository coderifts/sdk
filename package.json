{
  "name": "@coderifts/sdk",
  "version": "1.0.1",
  "description": "Agent Governance SDK — validate API changes before tool invocations. TypeScript client for the CodeRifts API.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coderifts",
    "api",
    "openapi",
    "breaking-changes",
    "mcp",
    "sdk",
    "agent",
    "governance",
    "ai-agent",
    "tool-safety"
  ],
  "author": "CodeRifts <hello@coderifts.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderifts/sdk.git"
  },
  "homepage": "https://coderifts.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
